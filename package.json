{
  "name": "vitta-vriksha",
  "version": "1.0.9",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "node tools/check-style-guidelines.mjs",
    "test": "node tools/check-style-guidelines.mjs && node --test test/*.test.mjs",
    "test:unit": "node --test test/*.test.mjs",
    "clean-sms": "node scripts/clean-sms.mjs",
    "verify:import": "node scripts/verify-import.mjs",
    "verify:overlap": "node scripts/verify-overlap.mjs",
    "vendor:casparser": "python tools/vendor-casparser.py",
    "vendor:libs": "python tools/vendor-libs.py",
    "build:android": "cmd.exe /c gradlew.bat assembleDebug",
    "build:release": "powershell -ExecutionPolicy Bypass -File ./tools/build-release.ps1",
    "deploy:release": "powershell -ExecutionPolicy Bypass -File ./tools/deploy-release.ps1",
    "bump": "node tools/bump-version.mjs",
    "bump:patch": "node tools/bump-version.mjs --type patch",
    "bump:minor": "node tools/bump-version.mjs --type minor",
    "bump:code": "node tools/bump-version.mjs --type code-only"
  },
  "dependencies": {
    "@chikatina/casparser-js": "^1.1.0"
  }
}

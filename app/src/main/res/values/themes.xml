<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.VittaVriksha" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_40</item>
        <item name="colorPrimaryVariant">@color/brand_30</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_60</item>
        <item name="colorSecondaryVariant">@color/brand_30</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- The WebView paints its own chrome, so the window background only has to
             match it during the first frame to avoid a white flash on launch. -->
        <item name="android:windowBackground">@color/surface_light</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

</resources>

    {
      "name": "NPM: build:release",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "build:release"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "NPM: deploy:release",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "deploy:release"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}

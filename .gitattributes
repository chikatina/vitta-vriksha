# Normalise text to LF in the repository and let each checkout decide.
* text=auto

# Shell scripts must keep LF endings everywhere. A CRLF here breaks the shebang, and the
# script fails with "bad interpreter: /usr/bin/env bash^M" on every platform including
# Git Bash on Windows.
*.sh          text eol=lf
scripts/dev   text eol=lf
gradlew       text eol=lf

# Windows batch files need CRLF.
*.cmd         text eol=crlf
*.bat         text eol=crlf

# Binary assets, never touched or diffed as text.
*.woff2       binary
*.png         binary
*.jar         binary
*.apk         binary
*.aab         binary
*.jks         binary
*.keystore    binary
*.so          binary
*.db          binary
